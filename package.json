{
    "name": "embr",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "build": "gradlew build",
        "test": "npx nx run-many -t test",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "release": "gradlew release",
        "backport": "node scripts/backport.mjs"
    },
    "workspaces": [
        "libraries/**",
        "modules/**"
    ],
    "dependencies": {
        "@changesets/cli": "2.29.5",
        "@inductiveautomation/perspective-client": "2.1.49",
        "@inductiveautomation/perspective-components": "2.1.49",
        "@inductiveautomation/perspective-designer": "2.1.49",
        "@inductiveautomation/perspective-drawing-common": "2.1.49",
        "lodash": "4.17.21",
        "react": "18.2.0",
        "react-dom": "18.2.0"
    },
    "devDependencies": {
        "@embr-js/eslint-config": "*",
        "@embr-js/tsconfig": "*",
        "@types/lodash": "4.17.20",
        "@types/react": "18.3.23",
        "@types/react-dom": "18.3.1",
        "@vitest/coverage-v8": "3.2.4",
        "@vitest/ui": "3.2.4",
        "eslint": "8.57.1",
        "nx": "21.3.11",
        "prettier": "3.6.2",
        "mobx": "5.15.7",
        "mobx-react-lite": "1.5.2",
        "typescript": "5.9.2",
        "vite": "7.1.1",
        "vitest": "3.2.4"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "20.19.0",
            "onFail": "ignore"
        }
    },
    "packageManager": "yarn@1.22.19"
}
